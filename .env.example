# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# Every variable is optional: the deterministic analytics engine runs with no
# credentials at all. Keys are only needed for the narrative (LLM) layer.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# Which provider narrates the agent's findings: anthropic | openai | gemini | none
# "none" forces deterministic mode: every number and recommendation still comes
# out, rendered from templates instead of an LLM. Use it for offline demos.
CARDIAC_LLM_PROVIDER=anthropic

# Anthropic (primary). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for planning, synthesis and verification.
CARDIAC_LLM_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# "high" is the default and is the right balance for this workload.
CARDIAC_LLM_EFFORT=high

# Maximum tokens the model may produce in one response.
CARDIAC_LLM_MAX_TOKENS=16000

# Optional alternative providers. Only read when CARDIAC_LLM_PROVIDER matches.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Paths -----------------------------------------------------------------
# Where the Cardiac workbook lives. Defaults to data/raw/cardiac_dataset.xlsx
CARDIAC_DATA_FILE=

# Root for the DuckDB warehouse and derived parquet files.
CARDIAC_WAREHOUSE_DIR=

# --- API service -----------------------------------------------------------
CARDIAC_API_HOST=127.0.0.1
CARDIAC_API_PORT=8000

# Comma-separated list of origins allowed to call the API from a browser.
CARDIAC_CORS_ORIGINS=http://localhost:8501

# Optional shared secret. When set, every /agent and /analytics request must
# send it as the `X-API-Key` header. Leave blank for local development.
CARDIAC_API_KEY=

# --- Behaviour -------------------------------------------------------------
# Refuse to answer questions outside the Cardiac case scope.
CARDIAC_ENFORCE_SCOPE=true

# Reject any LLM answer containing a number that is not present in the
# evidence pack. Strongly recommended: this is the anti-hallucination gate.
CARDIAC_ENFORCE_NUMERIC_GROUNDING=true

# Log level: DEBUG | INFO | WARNING | ERROR
CARDIAC_LOG_LEVEL=INFO
